# ASTRA — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# URL of the FastAPI backend server
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Clerk Authentication (required)
# ---------------------------------------------------------------------------
# Both keys must come from the SAME Clerk instance (Development or Production).
# Dashboard → API Keys. Never commit real values. Never expose CLERK_SECRET_KEY
# to client code (no NEXT_PUBLIC_ prefix on the secret).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_from_clerk_dashboard
CLERK_SECRET_KEY=sk_test_or_sk_live_from_clerk_dashboard

# App routes used by Clerk redirects / components
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Required when Clerk Dashboard has Application Proxy enabled (this app uses
# frontendApiProxy in proxy.ts). Typically:
#   https://YOUR_PRODUCTION_DOMAIN/__clerk
# For local dev you can omit this if proxy is production-only, or set:
#   http://localhost:3000/__clerk
# NEXT_PUBLIC_CLERK_PROXY_URL=https://your-domain.com/__clerk

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ---------------------------------------------------------------------------
# AI / OpenRouter
# ---------------------------------------------------------------------------
# Your OpenRouter API key — get one at https://openrouter.ai
# This key is SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ---------------------------------------------------------------------------
# Optional: Force a specific model
# (defaults to the primary model in config/models.ts)
# ---------------------------------------------------------------------------
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | production
NODE_ENV=development
